ALERTOPS_DATABASE_URL=postgresql+psycopg://alertops:alertops@localhost:5432/alertops
# Set a long random value locally; never use a production signing secret here.
ALERTOPS_WEBHOOK_SECRET=placeholder
SIMULATOR_DATABASE_URL=postgresql+psycopg://simulator:simulator@localhost:5433/simulator
# Independent provider credential; replace only in your local .env.
SIMULATOR_ACCOUNTS={"demo-store-01":"replace-with-a-separate-local-api-key"}
ALERTOPS_BROKER_URL=redis://127.0.0.1:6379/0
ALERTOPS_PROVIDER_URL=http://127.0.0.1:8001
# Must match the corresponding SIMULATOR_ACCOUNTS credential in local .env.
ALERTOPS_PROVIDER_KEYS={"demo-store-01":"replace-with-a-separate-local-api-key"}
